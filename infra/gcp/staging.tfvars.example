project_id      = "semantic-layer-staging"
environment     = "staging"
bucket_name     = "semantic-layer-bundles-staging-REPLACE"
meter_bucket_name = "semantic-layer-metering-staging-REPLACE"
key_registry_secret_version = "1"
container_image = "europe-west2-docker.pkg.dev/semantic-layer-staging/semantic-layer-services/semantic-layer-ingest@sha256:REPLACE"
max_instances   = 3
billing_account_id = "000000-000000-000000"
monthly_budget_amount = 100
budget_currency_code  = "USD"
ops_email          = "semantic-layer-ops@example.com"
bundle_operator_members       = ["group:semantic-layer-bundle-ops@example.com"]
trace_reader_members          = ["group:semantic-layer-trace-readers@example.com"]
release_builder_members       = ["group:semantic-layer-release@example.com"]
key_registry_operator_members = ["group:semantic-layer-key-ops@example.com"]
