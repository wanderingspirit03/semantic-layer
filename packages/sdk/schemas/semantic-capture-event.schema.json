{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-layer.dev/contracts/capture/v1/semantic-capture-event.schema.json",
  "title": "SemanticCaptureEventV1",
  "type": "object",
  "required": [
    "schema", "run_id", "record_id", "seq", "observed_at", "monotonic_ns",
    "trace_id", "source", "event_kind", "phase", "name", "native", "semantic",
    "correlation", "loss_refs", "blob_refs", "provenance"
  ],
  "properties": {
    "schema": { "const": "semantic_capture_event_v1" },
    "run_id": { "$ref": "#/$defs/id" },
    "record_id": { "$ref": "#/$defs/id" },
    "seq": { "type": "integer", "minimum": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "monotonic_ns": { "type": "integer", "minimum": 0 },
    "trace_id": { "$ref": "#/$defs/id" },
    "conversation_id": { "$ref": "#/$defs/id" },
    "turn_id": { "$ref": "#/$defs/id" },
    "turn_index": { "type": "integer", "minimum": 0 },
    "previous_turn_id": { "$ref": "#/$defs/id" },
    "run_correlation": { "$ref": "#/$defs/run_correlation" },
    "source": {
      "type": "object",
      "required": ["source_id", "name", "seam", "identity_domain", "official"],
      "properties": {
        "source_id": { "$ref": "#/$defs/source_id" },
        "name": { "$ref": "#/$defs/bounded" },
        "seam": { "$ref": "#/$defs/bounded" },
        "identity_domain": { "$ref": "#/$defs/bounded" },
        "official": { "type": "boolean" },
        "version": { "$ref": "#/$defs/bounded" }
      },
      "allOf": [
        {
          "if": { "properties": { "source_id": { "const": "builtin/manual" } }, "required": ["source_id"] },
          "then": { "properties": { "official": { "const": false } } }
        },
        {
          "if": {
            "properties": { "source_id": { "type": "string", "pattern": "^(?:builtin/semantic-layer-runtime|official/)" } },
            "required": ["source_id"]
          },
          "then": { "properties": { "official": { "const": true } } }
        },
        {
          "if": {
            "properties": { "source_id": { "type": "string", "pattern": "^(?!builtin/|official/)" } },
            "required": ["source_id"]
          },
          "then": { "properties": { "official": { "const": false } } }
        }
      ],
      "additionalProperties": true
    },
    "coverage": { "$ref": "#/$defs/coverage_identity" },
    "native_identity": { "$ref": "#/$defs/bounded" },
    "event_kind": {
      "enum": ["lifecycle", "model", "tool", "state", "log", "error", "stream", "correlation", "unknown", "loss"]
    },
    "phase": { "enum": ["start", "event", "end", "error", "cancelled", "gap"] },
    "name": { "$ref": "#/$defs/bounded" },
    "native": { "$ref": "#/$defs/json" },
    "semantic": { "$ref": "#/$defs/json_object" },
    "correlation": {
      "type": "object",
      "properties": {
        "parent_record_id": { "$ref": "#/$defs/id" },
        "parent_native_id": { "$ref": "#/$defs/bounded" },
        "traceparent": { "$ref": "#/$defs/bounded" },
        "links": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": true
    },
    "loss": {
      "type": "object",
      "required": ["reason", "stage", "recoverable"],
      "properties": {
        "reason": { "$ref": "#/$defs/loss_reason" },
        "stage": { "enum": ["source", "snapshot", "serialize", "scrub", "scan", "queue", "persist", "recover"] },
        "affected_record_id": { "$ref": "#/$defs/id" },
        "affected_path": { "type": "string", "maxLength": 2048 },
        "bytes": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 0 },
        "recoverable": { "type": "boolean" },
        "detail": { "type": "string", "maxLength": 1024 }
      },
      "additionalProperties": true
    },
    "loss_refs": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "blob_refs": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["digest", "algorithm", "byte_length", "scan", "inline_omitted"],
        "properties": {
          "digest": { "$ref": "#/$defs/sha256" },
          "algorithm": { "const": "sha256" },
          "mime_type": { "type": "string", "maxLength": 255 },
          "byte_length": { "type": "integer", "minimum": 0 },
          "scan": { "enum": ["clean", "blocked"] },
          "inline_omitted": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object",
      "required": ["language", "sdk_name", "sdk_version", "capture_policy"],
      "properties": {
        "language": { "enum": ["typescript", "python"] },
        "sdk_name": { "$ref": "#/$defs/bounded" },
        "sdk_version": { "$ref": "#/$defs/bounded" },
        "capture_policy": { "const": "rich_local_credential_scrubbed" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": { "properties": { "event_kind": { "const": "loss" } }, "required": ["event_kind"] },
      "then": { "required": ["loss"], "properties": { "phase": { "const": "gap" } } }
    },
    {
      "if": { "required": ["previous_turn_id"] },
      "then": { "required": ["turn_id"] }
    },
    {
      "if": { "properties": { "name": { "const": "semantic_layer.coverage.ownership" } }, "required": ["name"] },
      "then": {
        "required": ["coverage"],
        "properties": {
          "event_kind": { "const": "correlation" },
          "phase": { "const": "event" },
          "source": {
            "type": "object",
            "properties": { "source_id": { "const": "builtin/semantic-layer-runtime" } }
          },
          "semantic": { "$ref": "#/$defs/ownership_decision" }
        }
      }
    },
    {
      "if": { "properties": { "name": { "const": "semantic_layer.coverage.ownership_ambiguous" } }, "required": ["name"] },
      "then": {
        "required": ["coverage"],
        "properties": {
          "event_kind": { "const": "correlation" },
          "phase": { "const": "gap" },
          "source": {
            "type": "object",
            "properties": { "source_id": { "const": "builtin/semantic-layer-runtime" } }
          },
          "semantic": { "$ref": "#/$defs/ownership_ambiguity" },
          "correlation": { "$ref": "#/$defs/ownership_ambiguity_correlation" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "semantic": {
            "type": "object",
            "properties": { "type": { "const": "coverage.ownership.v1" } },
            "required": ["type"]
          }
        },
        "required": ["semantic"]
      },
      "then": { "properties": { "name": { "const": "semantic_layer.coverage.ownership" } } }
    },
    {
      "if": {
        "properties": {
          "semantic": {
            "type": "object",
            "properties": { "type": { "const": "coverage.ownership.ambiguity.v1" } },
            "required": ["type"]
          }
        },
        "required": ["semantic"]
      },
      "then": { "properties": { "name": { "const": "semantic_layer.coverage.ownership_ambiguous" } } }
    }
  ],
  "$defs": {
    "run_correlation": {
      "type": "object",
      "required": ["task_id", "execution"],
      "properties": {
        "task_id": { "$ref": "#/$defs/id" },
        "execution": {
          "type": "object",
          "required": ["system", "run_id"],
          "properties": {
            "system": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{2,127}$" },
            "run_id": { "$ref": "#/$defs/id" },
            "parent_run_id": { "$ref": "#/$defs/id" },
            "root_run_id": { "$ref": "#/$defs/id" },
            "attempt": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_:-]{7,127}$" },
    "bounded": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:builtin/(?:manual|semantic-layer-runtime)|official/[^\\s/]+|(?!builtin/|official/)[^\\s/]+(?:/[^\\s/]+)+)$"
    },
    "coverage_identity": {
      "type": "object",
      "required": ["operation", "domain", "identity_token"],
      "properties": {
        "operation": { "$ref": "#/$defs/bounded" },
        "domain": { "$ref": "#/$defs/bounded" },
        "identity_token": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "participant_source_id_list": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source_id" }
    },
    "secondary_source_id_list": {
      "type": "array",
      "maxItems": 255,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source_id" }
    },
    "ownership_decision": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type", "status", "primary_source_id", "participant_source_ids",
            "secondary_source_ids", "final"
          ],
          "properties": {
            "type": { "const": "coverage.ownership.v1" },
            "status": { "const": "owned" },
            "primary_source_id": { "$ref": "#/$defs/source_id" },
            "participant_source_ids": { "$ref": "#/$defs/participant_source_id_list" },
            "secondary_source_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 255,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/source_id" }
            },
            "final": { "const": true }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "status", "participant_source_ids", "secondary_source_ids", "final"],
          "properties": {
            "type": { "const": "coverage.ownership.v1" },
            "status": { "const": "ambiguous" },
            "participant_source_ids": { "$ref": "#/$defs/participant_source_id_list" },
            "secondary_source_ids": { "type": "array", "maxItems": 0 },
            "final": { "const": true }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "status", "participant_source_ids", "secondary_source_ids", "final"],
          "properties": {
            "type": { "const": "coverage.ownership.v1" },
            "status": { "const": "evidence_only" },
            "participant_source_ids": { "$ref": "#/$defs/participant_source_id_list" },
            "secondary_source_ids": { "type": "array", "maxItems": 0 },
            "final": { "const": true }
          },
          "additionalProperties": false
        }
      ]
    },
    "ownership_ambiguity": {
      "type": "object",
      "required": ["type", "decision_record_id"],
      "properties": {
        "type": { "const": "coverage.ownership.ambiguity.v1" },
        "decision_record_id": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "ownership_ambiguity_correlation": {
      "type": "object",
      "required": ["links"],
      "properties": {
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "additionalProperties": false
    },
    "json": {
      "oneOf": [
        { "type": "null" }, { "type": "boolean" }, { "type": "number" }, { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/json" } },
        { "$ref": "#/$defs/json_object" }
      ]
    },
    "json_object": { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } },
    "loss_reason": {
      "enum": [
        "credential_redaction", "configured_redaction", "scrubber_failure_payload_omitted",
        "serialization_failure", "unsafe_getter_avoided", "unsafe_helper_avoided",
        "size_overflow_blobbed", "size_overflow_discarded", "blob_scan_blocked",
        "queue_backpressure_drop", "persistence_failure", "unsupported_native_value", "source_rejection",
        "filter_limit_exclusion", "missing_parent_context", "parser_error_malformed_bytes",
        "missing_correlation_identity", "crash_recovery", "uncertain_tail", "shutdown_timeout", "turn_order_ambiguous"
      ]
    }
  }
}
