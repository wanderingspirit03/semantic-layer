{
  "detector_spec": "semantic-layer-credential-detectors-v4",
  "scrub_cases": [
    {
      "id": "structured-sensitive-values-are-replaced-as-one-finding",
      "secret_values": [],
      "input": {
        "reasoning": [{ "type": "text", "text": "safe reasoning" }],
        "authorization": {
          "scheme": "custom",
          "parts": ["opaque", "credential"]
        },
        "x-api-key": "opaque-provider-value",
        "safe_token_count": 3
      },
      "expected": {
        "reasoning": [{ "type": "text", "text": "safe reasoning" }],
        "authorization": "[REDACTED_CREDENTIAL]",
        "x-api-key": "[REDACTED_CREDENTIAL]",
        "safe_token_count": 3
      },
      "redactions": 2
    },
    {
      "id": "all-exact-secret-encodings-are-replaced",
      "secret_values": ["fixture\nsecret/value+", "fixture-secret-ÿÿ"],
      "input": {
        "raw": "before fixture\nsecret/value+ after",
        "json_escaped": "fixture\\nsecret/value+",
        "percent_encoded": "fixture%0Asecret%2Fvalue%2B",
        "unicode_json_escaped": "fixture-secret-\\u00ff\\u00ff",
        "unicode_percent_encoded": "fixture-secret-%C3%BF%C3%BF",
        "unicode_percent_encoded_lowercase": "fixture-secret-%c3%bf%c3%bf",
        "base64": "Zml4dHVyZS1zZWNyZXQtw7/Dvw==",
        "base64_without_padding": "Zml4dHVyZS1zZWNyZXQtw7/Dvw",
        "base64url": "Zml4dHVyZS1zZWNyZXQtw7_Dvw",
        "base64url_with_padding": "Zml4dHVyZS1zZWNyZXQtw7_Dvw=="
      },
      "expected": {
        "raw": "before [REDACTED_CREDENTIAL] after",
        "json_escaped": "[REDACTED_CREDENTIAL]",
        "percent_encoded": "[REDACTED_CREDENTIAL]",
        "unicode_json_escaped": "[REDACTED_CREDENTIAL]",
        "unicode_percent_encoded": "[REDACTED_CREDENTIAL]",
        "unicode_percent_encoded_lowercase": "[REDACTED_CREDENTIAL]",
        "base64": "[REDACTED_CREDENTIAL]",
        "base64_without_padding": "[REDACTED_CREDENTIAL]",
        "base64url": "[REDACTED_CREDENTIAL]",
        "base64url_with_padding": "[REDACTED_CREDENTIAL]"
      },
      "redactions": 10
    },
    {
      "id": "connection-and-query-credentials-preserve-safe-url-shape",
      "secret_values": [],
      "input": {
        "connection": "postgres://alice:p%40ss@db.example.test:5432/app?sslmode=require",
        "callback": "https://example.test/callback?mode=fast&api_key=query-secret#done"
      },
      "expected": {
        "connection": "postgres://alice:[REDACTED_CREDENTIAL]@db.example.test:5432/app?sslmode=require",
        "callback": "https://example.test/callback?mode=fast&api_key=[REDACTED_CREDENTIAL]#done"
      },
      "redactions": 2
    },
    {
      "id": "strict-built-in-formats-are-replaced",
      "secret_values": [],
      "input": {
        "google": "AIza0123456789abcdefghijklmnop",
        "openrouter": "{{OPENROUTER_KEY_64}}",
        "openai": "sk-proj-0123456789abcdefghijklmnopqrstuvwxyz_ABCD",
        "openai_admin": "sk-admin-0123456789abcdefghijklmnopqrstuvwxyz_ABCD",
        "anthropic": "sk-ant-api03-0123456789abcdefghijklmnopqrstuvwxyz_ABCD",
        "header": "Authorization: Bearer eyJhbGciOi.fixture-token",
        "private_key": "-----BEGIN PRIVATE KEY-----\nfixture-key-material\n-----END PRIVATE KEY-----"
      },
      "expected": {
        "google": "[REDACTED_CREDENTIAL]",
        "openrouter": "[REDACTED_CREDENTIAL]",
        "openai": "[REDACTED_CREDENTIAL]",
        "openai_admin": "[REDACTED_CREDENTIAL]",
        "anthropic": "[REDACTED_CREDENTIAL]",
        "header": "Authorization: Bearer [REDACTED_CREDENTIAL]",
        "private_key": "[REDACTED_CREDENTIAL]"
      },
      "redactions": 7
    },
    {
      "id": "ordinary-near-matches-and-injected-marker-remain-evidence",
      "secret_values": [],
      "input": {
        "short_provider_shape": "sk-short",
        "ordinary_long_sk_identifier": "sk-customer-session-0123456789abcdef0123456789abcdef",
        "legacy_or_unknown_sk_shape": "sk-0123456789abcdefghijklmnopqrstuvwxyz_ABCD",
        "openrouter_wrong_length": "{{OPENROUTER_KEY_32}}",
        "openai_admin_too_short": "sk-admin-short",
        "openai_admin_ordinary_identifier": "sk-admin-dashboard",
        "openai_admin_legacy_length": "sk-admin-1234abcd",
        "sentence_start_bearer": "Bearer authentication is required here.",
        "prose": "Use Bearer authentication when the server requires it.",
        "database": "postgresql://db.example.test/app",
        "token_count": 9,
        "marker": "[REDACTED_CREDENTIAL]"
      },
      "expected": {
        "short_provider_shape": "sk-short",
        "ordinary_long_sk_identifier": "sk-customer-session-0123456789abcdef0123456789abcdef",
        "legacy_or_unknown_sk_shape": "sk-0123456789abcdefghijklmnopqrstuvwxyz_ABCD",
        "openrouter_wrong_length": "{{OPENROUTER_KEY_32}}",
        "openai_admin_too_short": "sk-admin-short",
        "openai_admin_ordinary_identifier": "sk-admin-dashboard",
        "openai_admin_legacy_length": "sk-admin-1234abcd",
        "sentence_start_bearer": "Bearer authentication is required here.",
        "prose": "Use Bearer authentication when the server requires it.",
        "database": "postgresql://db.example.test/app",
        "token_count": 9,
        "marker": "[REDACTED_CREDENTIAL]"
      },
      "redactions": 0
    },
    {
      "id": "unknown-provider-shapes-require-explicit-configuration",
      "secret_values": ["sk-custom-0123456789abcdefghijklmnopqrstuvwxyz"],
      "input": {
        "configured": "sk-custom-0123456789abcdefghijklmnopqrstuvwxyz",
        "unconfigured": "sk-customer-session-0123456789abcdef0123456789abcdef"
      },
      "expected": {
        "configured": "[REDACTED_CREDENTIAL]",
        "unconfigured": "sk-customer-session-0123456789abcdef0123456789abcdef"
      },
      "redactions": 1
    }
  ],
  "scan_cases": [
    {
      "id": "parsed-sensitive-field-with-opaque-value-is-blocked",
      "secret_values": [],
      "text": "{\"name\":\"event\",\"api_key\":\"opaque-value\"}\n",
      "clean": false
    },
    {
      "id": "parsed-redacted-sensitive-field-is-clean",
      "secret_values": [],
      "text": "{\"name\":\"event\",\"api_key\":\"[REDACTED_CREDENTIAL]\"}\n",
      "clean": true
    },
    {
      "id": "json-escaped-quote-bounds-query-value",
      "secret_values": [],
      "text": "{\"output\":\"command \\\"https://example.test/callback?api_key=[REDACTED_CREDENTIAL]\\\"\"}\n",
      "clean": true
    },
    {
      "id": "decoded-unicode-escape-cannot-hide-exact-secret",
      "secret_values": ["secret-value"],
      "text": "{\"output\":\"\\u0073ecret-value\"}\n",
      "clean": false
    },
    {
      "id": "jsonl-records-are-inspected-independently",
